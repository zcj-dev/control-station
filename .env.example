# ─────────────────────────────────────────────────────────────
# control-station 环境变量模板
# 复制成 .env 填真值。.env 已被 .gitignore, 永远不要提交。
#   Windows:  copy .env.example .env
#   VPS:      cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── DSH 网关鉴权 ──────────────────────────────────────────
# DSH 内部 8326 端口的真实 OpenAI 兼容 key
DSH_GATEWAY_KEY=
# 对外暴露用的 shell key (Caddy 校验用, 换成真 key 后转发)
DSH_SHELL_KEY=

# ── MCP (u2mcp Android 自动化) ────────────────────────────
# u2mcp HTTP 服务 Bearer token
MCP_BEARER_TOKEN=

# ── VPS (美西 DediRock) ───────────────────────────────────
VPS_SSH_PASSWORD=
# Tailscale IP (公网 22 被墙, 必须走这个)
VPS_TAILSCALE_IP=
VPS_PUBLIC_IP=
VPS_HOSTNAME=

# ── 节点地址 ──────────────────────────────────────────────
# 本机 (Windows 中控站)
DSH_HOST_IP=
DSH_PORT=3080
DSH_GATEWAY_PORT=8326
CDY_WEB_PORT=3081
CDY_GATEWAY_PORT=8327
U2MCP_PORT=8765

# ── 模型通道密钥 ──────────────────────────────────────────
NVIDIA_NIM_API_KEY=
DEEPSEEK_API_KEY=

# ── 公网入口 ──────────────────────────────────────────────
# Let's Encrypt 证书域名 (nip.io 免费 IP 域名)
PUBLIC_DOMAIN=
# nginx 访问口令
PUBLIC_ACCESS_KEY=
